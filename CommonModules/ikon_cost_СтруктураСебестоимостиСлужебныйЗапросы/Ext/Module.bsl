|			И Т.АналитикаУчетаПартий = Расход.АналитикаУчетаПартий
|			И Т.Партия = Расход.Партия
|			И Т.Период >= Расход.Период
|			И (Расход.Период >= ЕСТЬNULL(Интервалы.НачалоПериода, ДАТАВРЕМЯ(1,1,1)))
