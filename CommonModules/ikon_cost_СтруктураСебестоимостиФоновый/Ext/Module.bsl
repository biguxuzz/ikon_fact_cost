// Модуль предназначен для итерационной подготовки
// регистра сведений ikon_cost_ДетализацияЗатратСебестоимости
// Версия: 0.1.1.258

#Область ПрограммныйИнтерфейс

// Предварительный расчёт кэша себестоимости за период (запускается в фоне)
//
// Параметры:
//   ПараметрыВыполнения - Структура:
//     * НачалоПериода - Дата - начало периода расчёта
//     * КонецПериода - Дата - конец периода расчёта
//     * ПринудительноПересчитать - Булево - пересчитать даже если кэш есть (по умолчанию Ложь)
//     * ОтборПоПродукции - Массив - список номенклатуры для расчёта (необязательный)
//     * ОтборПоОрганизациям - Массив - список организаций для расчёта (необязательный)
//
Процедура ПредварительныйРасчётКэшаСебестоимости(Знач ПараметрыВыполнения) Экспорт

	НачалоПериода = ПараметрыВыполнения.НачалоПериода;
	КонецПериода = ПараметрыВыполнения.КонецПериода;
	ПринудительноПересчитать = ПараметрыВыполнения.Свойство("ПринудительноПересчитать")
		И ПараметрыВыполнения.ПринудительноПересчитать;

	// Новые параметры отбора
	ОтборПоПродукции = Неопределено;
	Если ПараметрыВыполнения.Свойство("ОтборПоПродукции") Тогда
		ОтборПоПродукции = ПараметрыВыполнения.ОтборПоПродукции;
	КонецЕсли;

	ОтборПоОрганизациям = Неопределено;
	Если ПараметрыВыполнения.Свойство("ОтборПоОрганизациям") Тогда
		ОтборПоОрганизациям = ПараметрыВыполнения.ОтборПоОрганизациям;
	КонецЕсли;

	ВремяНачала = ТекущаяУниверсальнаяДата();

	// Формируем строку отборов для логирования
	СтрокаОтборов = "";
	Если ЗначениеЗаполнено(ОтборПоПродукции) Тогда
		СтрокаОтборов = СтрокаОтборов + СтрШаблон(", Продукция: %1 шт.", ОтборПоПродукции.Количество());
	КонецЕсли;
	Если ЗначениеЗаполнено(ОтборПоОрганизациям) Тогда
		СтрокаОтборов = СтрокаОтборов + СтрШаблон(", Организации: %1 шт.", ОтборПоОрганизациям.Количество());
	КонецЕсли;

	// Логирование начала
	ЗаписьЖурналаРегистрации(
		НСтр("ru = 'ikon_cost: Предварительный расчёт кэша себестоимости'"),
		УровеньЖурналаРегистрации.Информация,
		,
		,
		СтрШаблон("v0.1.1.258: Начало расчёта за период: %1 - %2%3", НачалоПериода, КонецПериода, СтрокаОтборов));

	КоличествоОбработанныхМесяцев = 0;
	ОбщееКоличествоЗаписей = 0;

	// Цикл по месяцам периода
	ТекущаяДата = НачалоМесяца(НачалоПериода);
	Пока ТекущаяДата <= КонецПериода Цикл

		ПериодРасчёта = ТекущаяДата;
		ДатаОкончания = КонецМесяца(ТекущаяДата);

		Статистика = Новый Структура;
		Результат = РассчитатьКэшЗаМесяц(
			ПериодРасчёта,
			ДатаОкончания,
			ПринудительноПересчитать,
			Статистика,
			ОтборПоПродукции,
			ОтборПоОрганизациям);

		Если Результат Тогда
			КоличествоОбработанныхМесяцев = КоличествоОбработанныхМесяцев + 1;
			ОбщееКоличествоЗаписей = ОбщееКоличествоЗаписей + Статистика.КоличествоЗаписей;
		КонецЕсли;

		// Переход к следующему месяцу
		ТекущаяДата = ДобавитьМесяц(ТекущаяДата, 1);
	КонецЦикла;

	// Логирование завершения
	ВремяВыполнения = ТекущаяУниверсальнаяДата() - ВремяНачала;
	ЗаписьЖурналаРегистрации(
		НСтр("ru = 'ikon_cost: Предварительный расчёт кэша себестоимости'"),
		УровеньЖурналаРегистрации.Информация,
		,
		,
		СтрШаблон("Завершён расчёт. Месяцев: %1, Записей: %2, Время: %3 сек",
			КоличествоОбработанныхМесяцев,
			ОбщееКоличествоЗаписей,
			Окр(ВремяВыполнения, 2)));

КонецПроцедуры

#КонецОбласти

#Область СлужебныеМетоды

// Выполняет расчёт кэша для указанного месяца с опциональным отбором по продукции
//
// Параметры:
//   ПериодРасчёта - Дата - первый день месяца для расчёта
//   ДатаОкончания - Дата - дата окончания периода
//   ПринудительноПересчитать - Булево - пересчитать даже если кэш есть
//   Статистика - Структура - возвращает статистику выполнения
//   ОтборПоПродукции - Массив - список СправочникСсылка.Номенклатура для расчёта (необязательный)
//   ОтборПоОрганизациям - Массив - список СправочникСсылка.Организации для расчёта (необязательный)
//
// Возвращаемое значение:
//   Булево - Истина если успешно
//
Функция РассчитатьКэшЗаМесяц(
	ПериодРасчёта,
	ДатаОкончания,
	ПринудительноПересчитать = Ложь,
	Статистика = Неопределено,
	ОтборПоПродукции = Неопределено,
	ОтборПоОрганизациям = Неопределено)

	Если Статистика = Неопределено Тогда
		Статистика = Новый Структура;
	КонецЕсли;

	Статистика.Вставить("КоличествоЗаписей", 0);
	Статистика.Вставить("Ошибка", "");

	Попытка

		ВерсияКэша = ikon_cost_КэшированиеРасчётов.ВерсияАлгоритмаРасчёта();

		// Определяем режим работы: полный период или частичный отбор
		ЭтоЧастичныйРасчёт = ЗначениеЗаполнено(ОтборПоПродукции)
			ИЛИ ЗначениеЗаполнено(ОтборПоОрганизациям);

		// === ШАГ 1: Проверка наличия кэша ===
		Если НЕ ПринудительноПересчитать Тогда

			Если ЭтоЧастичныйРасчёт Тогда
				// Проверяем наличие кэша только для указанной продукции
				ЕстьКэш = ikon_cost_КэшированиеРасчётов.ЕстьДанныеВКэшеПоПродукции(
					ПериодРасчёта,
					ВерсияКэша,
					ОтборПоПродукции);
			Иначе
				// Проверяем наличие кэша за весь период
				ЕстьКэш = ikon_cost_КэшированиеРасчётов.ЕстьДанныеВКэше(ПериодРасчёта, ВерсияКэша);
			КонецЕсли;

			Если ЕстьКэш Тогда
				ЗаписьЖурналаРегистрации(
					НСтр("ru = 'ikon_cost: Пропуск расчёта кэша'"),
					УровеньЖурналаРегистрации.Информация,
					,
					,
					СтрШаблон("Кэш уже существует за период: %1%2",
						ПериодРасчёта,
						?(ЭтоЧастичныйРасчёт, " (частичный)", "")));
				Возврат Истина;
			КонецЕсли;
		КонецЕсли;

		// === ШАГ 2: Получение аналитики для отбора ===
		СписокАналитики = Неопределено;
		Если ЗначениеЗаполнено(ОтборПоПродукции) Тогда
			СписокАналитики = ikon_cost_КэшированиеРасчётов.ПолучитьАналитикуПоНоменклатуре(
				ПериодРасчёта,
				ДатаОкончания,
				ОтборПоПродукции);
		КонецЕсли;

		// === ШАГ 3: Очистка кэша перед расчётом ===
		Если ЭтоЧастичныйРасчёт И ЗначениеЗаполнено(СписокАналитики) Тогда
			// Удаляем только записи для указанной продукции
			ikon_cost_КэшированиеРасчётов.ОчиститьКэшПоПродукции(ПериодРасчёта, СписокАналитики);
		Иначе
			// Удаляем все записи за период
			ikon_cost_КэшированиеРасчётов.ОчиститьКэшЗаПериод(ПериодРасчёта);
		КонецЕсли;

		// === ШАГ 4: Подготовка параметров ===
		МенеджерВТ = Новый МенеджерВременныхТаблиц;
		ВалютаУправленческогоУчета = Константы.ВалютаУправленческогоУчета.Получить();
		ДанныеПоСебестоимости = 3; // Управленческий учёт

		// Параметры дерева
		ПараметрыДереваСебестоимости = СтруктураСебестоимости.ПараметрыДереваСебестоимости();
		ПараметрыДереваСебестоимости.Вставить("ИспользоватьПакетнуюОбработку", Истина);
		ПараметрыДереваСебестоимости.Вставить("ДинамическоеСчитывание", Ложь);
		ПараметрыДереваСебестоимости.Вставить("ТипРезультата", "МенеджерВременныхТаблиц");
		ПараметрыДереваСебестоимости.Вставить("Результат", МенеджерВТ);
		ПараметрыДереваСебестоимости.Вставить("ИспользоватьКэширование", Истина);
		ПараметрыДереваСебестоимости.Вставить("ПериодРасчёта", ПериодРасчёта);
		ПараметрыДереваСебестоимости.Вставить("ВерсияАлгоритма", ВерсияКэша);
		ПараметрыДереваСебестоимости.Вставить("ДатаОкончания", ДатаОкончания);

		// Параметры узла
		ПараметрыУзлаДереваСебестоимости = СтруктураСебестоимости.ПараметрыУзлаДереваСебестоимости();
		ПараметрыУзлаДереваСебестоимости.ИнтерактивнаяНастройка = Истина;
		ПараметрыУзлаДереваСебестоимости.Отборы.ДанныеПоСебестоимости = ДанныеПоСебестоимости;
		ПараметрыУзлаДереваСебестоимости.Отборы.РазворачиватьДопРасходы = Истина;
		ПараметрыУзлаДереваСебестоимости.Отборы.ДатаОкончания = ДатаОкончания;
		ПараметрыУзлаДереваСебестоимости.Отборы.ВалютаУправленческогоУчета = ВалютаУправленческогоУчета;

		// === ШАГ 5: Установка отборов по продукции ===
		Если ЗначениеЗаполнено(ОтборПоПродукции) Тогда
			ПараметрыУзлаДереваСебестоимости.Отборы.Продукция = ОтборПоПродукции;
		КонецЕсли;

		Если ЗначениеЗаполнено(ОтборПоОрганизациям) Тогда
			ПараметрыУзлаДереваСебестоимости.Отборы.Организации = ОтборПоОрганизациям;
		КонецЕсли;

		// === ШАГ 6: Выполнение расчёта ===
		СтруктураСебестоимости.ПостроитьДеревоСебестоимости(ПараметрыДереваСебестоимости, ПараметрыУзлаДереваСебестоимости);

		// === ШАГ 7: Запись в кэш ===
		// Запись в кэш происходит внутри ПостроитьДеревоСебестоимости при ИспользоватьКэширование = Истина
		// Но для надёжности вызываем явно (функция проверит наличие данных в МенеджерВТ)
		ikon_cost_КэшированиеРасчётов.ЗаписатьРезультатВКэш(
			МенеджерВТ,
			ПериодРасчёта,
			ВерсияКэша,
			ДанныеПоСебестоимости,
			ДатаОкончания);

		// === ШАГ 8: Подсчёт записей ===
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ
			|	КОЛИЧЕСТВО(*) КАК КоличествоЗаписей
			|ИЗ
			|	РегистрСведений.ikon_cost_ДетализацияЗатратСебестоимости
			|ГДЕ
			|	Период = &Период
			|	И ВерсияРасчёта = &Версия";
		Запрос.УстановитьПараметр("Период", ПериодРасчёта);
		Запрос.УстановитьПараметр("Версия", ВерсияКэша);

		РезультатЗапроса = Запрос.Выполнить();
		Если НЕ РезультатЗапроса.Пустой() Тогда
			Выборка = РезультатЗапроса.Выбрать();
			Выборка.Следующий();
			Статистика.КоличествоЗаписей = Выборка.КоличествоЗаписей;
		КонецЕсли;

		ЗаписьЖурналаРегистрации(
			НСтр("ru = 'ikon_cost: Расчёт кэша за месяц'"),
			УровеньЖурналаРегистрации.Информация,
			,
			,
			СтрШаблон("Период: %1, Записей: %2%3",
				ПериодРасчёта,
				Статистика.КоличествоЗаписей,
				?(ЭтоЧастичныйРасчёт, " (частичный)", "")));

		Возврат Истина;

	Исключение

		ИнформацияОбОшибке = ИнформацияОбОшибке();
		Статистика.Ошибка = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке);

		ЗаписьЖурналаРегистрации(
			НСтр("ru = 'ikon_cost: Ошибка расчёта кэша'"),
			УровеньЖурналаРегистрации.Ошибка,
			,
			,
			СтрШаблон("Период: %1, Ошибка: %2", ПериодРасчёта, Статистика.Ошибка));

		Возврат Ложь;

	КонецПопытки;

КонецФункции

#КонецОбласти
