// Функции кэширования расчёта себестоимости
// Версия: 0.1.1.260
// Регистр: ikon_cost_ДетализацияЗатратСебестоимости

#Область КэшированиеРасчётов

// Версия алгоритма расчёта (для инвалидации кэша)
// При изменении алгоритма увеличить версию
Функция ВерсияАлгоритмаРасчёта() Экспорт
	Возврат "v0.1.1.260";
КонецФункции

// Проверяет наличие кэшированных данных за период
//
// Параметры:
//   ПериодРасчёта - Дата - первый день месяца
//   Версия - Строка - версия алгоритма
//
// Возвращаемое значение:
//   Булево - Истина если данные есть и версия совпадает
//
Функция ЕстьДанныеВКэше(ПериодРасчёта, Версия) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	1 КАК ЕстьДанные
	|ИЗ
	|	РегистрСведений.ikon_cost_ДетализацияЗатратСебестоимости КАК Данные
	|ГДЕ
	|	Данные.Период = &Период
	|	И Данные.ВерсияРасчёта = &Версия";

	Запрос.УстановитьПараметр("Период", ПериодРасчёта);
	Запрос.УстановитьПараметр("Версия", Версия);

	Результат = Запрос.Выполнить();
	Возврат НЕ Результат.Пустой();

КонецФункции

// Записывает результат расчёта в регистр сведений
//
// Параметры:
//   МенеджерВТ - МенеджерВременныхТаблиц - содержит таблицу "Результат"
//   ПериодРасчёта - Дата - первый день месяца
//   Версия - Строка - версия алгоритма
//   ДанныеПоСебестоимости - Число - вариант данных по себестоимости
//   ДатаОкончания - Дата - дата окончания периода
//
Процедура ЗаписатьРезультатВКэш(МенеджерВТ, ПериодРасчёта, Версия, ДанныеПоСебестоимости, ДатаОкончания) Экспорт

	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.УстановитьПараметр("Период", ПериодРасчёта);
	Запрос.УстановитьПараметр("Версия", Версия);
	Запрос.УстановитьПараметр("ДатаРасчёта", ТекущаяДатаСеанса());

	// Выбираем данные из таблицы Результат и преобразуем для записи в регистр
	// Исключаем строки с ТребуетсяРазузлование=Истина (это промежуточные узлы)
	// Добавляем группировку по ключевым полям для избежания дубликатов
	Запрос.Текст =
	"ВЫБРАТЬ
	|	&Период КАК Период,
	|	&Версия КАК ВерсияРасчёта,
	|	&ДатаРасчёта КАК ДатаРасчёта,
	|	Результат.Организация КАК Организация,
	|	Результат.АналитикаУчетаПродукции КАК АналитикаУчетаПродукции,
	|	Результат.ПартияПродукции КАК ПартияПродукции,
	|	Результат.АналитикаУчетаПартийПродукции КАК АналитикаУчетаПартийПродукции,
	|	Результат.Уровень КАК Уровень,
	|	Результат.Номенклатура КАК Номенклатура,
	|	Результат.Характеристика КАК Характеристика,
	|	Результат.Серия КАК Серия,
	|	Результат.ПартияЗатрата КАК ПартияЗатрата,
	|	Результат.АналитикаУчетаПартийЗатрата КАК АналитикаУчетаПартийЗатрата,
	|	Результат.ТипЗатрат КАК ТипЗатрат,
	|	Результат.Подразделение КАК Подразделение,
	|	СУММА(Результат.Количество) КАК КоличествоЗатрата,
	|	СУММА(Результат.Сумма) КАК СуммаЗатрата,
	|	СУММА(Результат.СуммаЗабалансовая) КАК СуммаЗабалансовая,
	|	СУММА(Результат.Материальные) КАК Материальные,
	|	СУММА(Результат.Трудозатраты) КАК Трудозатраты,
	|	СУММА(Результат.ПостатейныеПостоянные) КАК ПостатейныеПостоянные,
	|	СУММА(Результат.ПостатейныеПеременные) КАК ПостатейныеПеременные,
	|	СУММА(Результат.ДопРасходы) КАК ДопРасходы,
	|	СУММА(Результат.НДД) КАК НДД,
	|	СУММА(Результат.МатериальныеСНДС) КАК МатериальныеСНДС,
	|	СУММА(Результат.ТрудозатратыСНДС) КАК ТрудозатратыСНДС,
	|	СУММА(Результат.ПостатейныеПостоянныеСНДС) КАК ПостатейныеПостоянныеСНДС,
	|	СУММА(Результат.ПостатейныеПеременныеСНДС) КАК ПостатейныеПеременныеСНДС,
	|	СУММА(Результат.ДопРасходыСНДС) КАК ДопРасходыСНДС,
	|	СУММА(Результат.МатериальныеБезНДС) КАК МатериальныеБезНДС,
	|	СУММА(Результат.ПостатейныеПостоянныеБезНДС) КАК ПостатейныеПостоянныеБезНДС,
	|	СУММА(Результат.ПостатейныеПеременныеБезНДС) КАК ПостатейныеПеременныеБезНДС,
	|	СУММА(Результат.ДопРасходыБезНДС) КАК ДопРасходыБезНДС,
	|	СУММА(Результат.МатериальныеУпр) КАК МатериальныеУпр,
	|	СУММА(Результат.ТрудозатратыУпр) КАК ТрудозатратыУпр,
	|	СУММА(Результат.ПостатейныеПостоянныеУпр) КАК ПостатейныеПостоянныеУпр,
	|	СУММА(Результат.ПостатейныеПеременныеУпр) КАК ПостатейныеПеременныеУпр,
	|	СУММА(Результат.ДопРасходыУпр) КАК ДопРасходыУпр,
	|	СУММА(Результат.СтоимостьЗабалансоваяУпр) КАК СтоимостьЗабалансоваяУпр,
	|	СУММА(Результат.МатериальныеРегл) КАК МатериальныеРегл,
	|	СУММА(Результат.ТрудозатратыРегл) КАК ТрудозатратыРегл,
	|	СУММА(Результат.ПостатейныеПостоянныеРегл) КАК ПостатейныеПостоянныеРегл,
	|	СУММА(Результат.ПостатейныеПеременныеРегл) КАК ПостатейныеПеременныеРегл,
	|	СУММА(Результат.ДопРасходыРегл) КАК ДопРасходыРегл,
	|	СУММА(Результат.СтоимостьЗабалансоваяРегл) КАК СтоимостьЗабалансоваяРегл,
	|	СУММА(Результат.НалоговыйУчет) КАК НалоговыйУчет,
	|	СУММА(Результат.ПостояннаяРазница) КАК ПостояннаяРазница,
	|	СУММА(Результат.ВременнаяРазница) КАК ВременнаяРазница,
	|	МАКСИМУМ(Результат.ТребуетсяРазузлование) КАК ТребуетсяРазузлование,
	|	МАКСИМУМ(Результат.ТребуетсяРазузлованиеДопРасходов) КАК ТребуетсяРазузлованиеДопРасходов
	|ИЗ
	|	Результат КАК Результат
	|ГДЕ
	|	НЕ Результат.ТребуетсяРазузлование
	|	И НЕ (Результат.ТребуетсяРазузлованиеДопРасходов И Результат.ДопРасходы <> 0)
	|
	|СГРУППИРОВАТЬ ПО
	|	Результат.Организация,
	|	Результат.АналитикаУчетаПродукции,
	|	Результат.ПартияПродукции,
	|	Результат.АналитикаУчетаПартийПродукции,
	|	Результат.Уровень,
	|	Результат.Номенклатура,
	|	Результат.Характеристика,
	|	Результат.Серия,
	|	Результат.ПартияЗатрата,
	|	Результат.АналитикаУчетаПартийЗатрата,
	|	Результат.ТипЗатрат,
	|	Результат.Подразделение";

	ТаблицаДанных = Запрос.Выполнить().Выгрузить();

	// Строим НаборЗаписей вручную с дедупликацией по строковому ключу.
	// Проблема: поля составного типа ДокументПартии (ПартияЗатрата, ПартияПродукции) могут
	// содержать пустые ссылки разных типов (EmptyRef(TypeA) и EmptyRef(TypeB)), которые
	// SQL GROUP BY считает разными группами, но регистр — одним ключом.
	// Решение: строим набор через Добавить(), пропуская дубликаты по строковому представлению.
	// Строка() для любой пустой ссылки возвращает "", поэтому все варианты пустоты
	// объединяются в один ключ ещё до попадания в набор.

	// Удаляем только записи для текущей продукции (по АналитикаУчетаПродукции)
	// Это позволяет сохранять кэш для других продукции при повторном запуске отчёта
	Если ТаблицаДанных.Количество() > 0 Тогда
		СписокАналитики = ТаблицаДанных.ВыгрузитьКолонку("АналитикаУчетаПродукции");
		// Убираем дубликаты и пустые значения
		СписокАналитики.Свернуть("Значение");
		Если СписокАналитики.Количество() > 0 Тогда
			ОчиститьКэшПоПродукции(ПериодРасчёта, СписокАналитики);
		КонецЕсли;
	КонецЕсли;

	// Создаём набор для новых записей
	НаборЗаписей = РегистрыСведений.ikon_cost_ДетализацияЗатратСебестоимости.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Период.Установить(ПериодРасчёта);

	// Поля составного типа ДокументПартии: Строка() для пустых ссылок разных типов
	// возвращает разные строки (включая имя типа), но регистр с TypeReductionMode=TransformValues
	// преобразует все пустые ссылки к одному каноническому значению.
	// Используем ЗначениеЗаполнено() для нормализации: все пустые ссылки → фиксированная строка "0".
	ДатаРасчётаТек = ТекущаяДатаСеанса();
	Для Каждого ТекСтрока Из ТаблицаДанных Цикл
		НоваяЗапись = НаборЗаписей.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяЗапись, ТекСтрока);
		НоваяЗапись.Период = ПериодРасчёта;
		НоваяЗапись.ВерсияРасчёта = Версия;
		НоваяЗапись.ДатаРасчёта = ДатаРасчётаТек;
	КонецЦикла;

	// Используем Замена (Истина) + Объединение (Истина) для автоматической обработки дубликатов
	// Второй параметр Истина включает режим объединения: при дубликатах ресурсы суммируются, атрибуты берутся из последней записи
	НаборЗаписей.Записать();

КонецПроцедуры

// Получает данные из кэша и формирует внешние наборы для отчёта
//
// Параметры:
//   ПериодРасчёта - Дата - первый день месяца
//   НастройкиОтчета - НастройкиКомпоновкиДанных - настройки отчёта
//   ДанныеПоСебестоимости - Число - вариант данных
//   ВалютаУправленческогоУчета - СправочникСсылка.Валюты
//   ДатаОкончания - Дата
//
// Возвращаемое значение:
//   Структура - с ключами "Факт" и "Выпуски" (ТаблицаЗначений)
//
Функция ПолучитьДанныеИзКэша(ПериодРасчёта, НастройкиОтчета, ДанныеПоСебестоимости, ВалютаУправленческогоУчета, ДатаОкончания) Экспорт

	// Формируем отборы из настроек отчёта
	ОтборОрганизации = Неопределено;
	ОтборПродукции = Неопределено;
	ОтборПартии = Неопределено;
	ПоВсемОрганизациям = Истина;
	ПоВсейПродукции = Истина;
	ПоВсемПартиям = Истина;

	Для Каждого ЭлементОтбора Из НастройкиОтчета.Отбор.Элементы Цикл
		Если НЕ ЭлементОтбора.Использование Тогда
			Продолжить;
		КонецЕсли;

		Если ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Организация") Тогда
			ОтборОрганизации = ЭлементОтбора.ПравоеЗначение;
			ПоВсемОрганизациям = Ложь;
		ИначеЕсли ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Продукция") Тогда
			ОтборПродукции = ЭлементОтбора.ПравоеЗначение;
			ПоВсейПродукции = Ложь;
		ИначеЕсли ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ПартияПродукции") Тогда
			ОтборПартии = ЭлементОтбора.ПравоеЗначение;
			ПоВсемПартиям = Ложь;
		КонецЕсли;
	КонецЦикла;

	// Основной запрос к регистру
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Период", ПериодРасчёта);
	Запрос.УстановитьПараметр("ПоВсемОрганизациям", ПоВсемОрганизациям);
	Запрос.УстановитьПараметр("Организации", ОтборОрганизации);
	Запрос.УстановитьПараметр("ПоВсейПродукции", ПоВсейПродукции);
	Запрос.УстановитьПараметр("Продукция", ОтборПродукции);
	Запрос.УстановитьПараметр("ПоВсемПартиям", ПоВсемПартиям);
	Запрос.УстановитьПараметр("ПартииПродукции", ОтборПартии);
	Запрос.УстановитьПараметр("ДанныеПоСебестоимости", ДанныеПоСебестоимости);
	Запрос.УстановитьПараметр("ВалютаУправленческогоУчета", ВалютаУправленческогоУчета);

	// Таблица затрат (Факт)
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КлючиАналитики.Номенклатура КАК Продукция,
	|	КлючиАналитики.Характеристика КАК ХарактеристикаПродукции,
	|	КлючиАналитики.Назначение КАК НазначениеПродукции,
	|	Данные.ПартияПродукции КАК ПартияПродукции,
	|	Данные.Номенклатура КАК Полуфабрикат,
	|	Данные.Характеристика КАК ХарактеристикаПолуфабриката,
	|	Данные.Номенклатура КАК Затрата,
	|	Данные.Характеристика КАК ХарактеристикаЗатраты,
	|	Данные.СуммаЗатрата КАК Стоимость,
	|	Данные.Материальные КАК Материальные,
	|	Данные.ДопРасходы КАК ДопРасходы,
	|	Данные.Трудозатраты КАК Трудозатраты,
	|	Данные.ПостатейныеПостоянные КАК ПостатейныеПостоянные,
	|	Данные.ПостатейныеПеременные КАК ПостатейныеПеременные,
	|	Данные.СуммаЗабалансовая КАК Забалансовые,
	|	Данные.НалоговыйУчет КАК НалоговыйУчет,
	|	Данные.ПостояннаяРазница КАК ПостояннаяРазница,
	|	Данные.ВременнаяРазница КАК ВременнаяРазница,
	|	Данные.НДД КАК НДД,
	|	Данные.КоличествоЗатрата КАК Количество,
	|	КлючиАналитики.Номенклатура.ЕдиницаИзмерения КАК ЕдиницаИзмеренияПродукции,
	|	Данные.Номенклатура.ЕдиницаИзмерения КАК ЕдиницаИзмеренияПолуфабриката,
	|	Данные.Номенклатура.ЕдиницаИзмерения КАК ЕдиницаИзмеренияЗатраты,
	|	Данные.Организация КАК Организация,
	|	Данные.Подразделение КАК СтатьяКалькуляции,
	|	Данные.Подразделение КАК Подразделение,
	|	""Продукция"" КАК ТипДанных,
	|	Данные.Серия КАК Серия,
	|	Данные.ПартияЗатрата КАК ПартияЗатраты,
	|	Данные.Уровень КАК Уровень,
	|	ЕСТЬNULL(Данные.ТребуетсяРазузлование, ЛОЖЬ) КАК ТребуетсяРазузлование,
	|	ЕСТЬNULL(Данные.ТребуетсяРазузлованиеДопРасходов, ЛОЖЬ) КАК ТребуетсяРазузлованиеДопРасходов,
	|	ВЫБОР
	|		КОГДА &ДанныеПоСебестоимости = 3
	|			ТОГДА Данные.Организация.ВалютаРегламентированногоУчета
	|		ИНАЧЕ &ВалютаУправленческогоУчета
	|	КОНЕЦ КАК Валюта
	|ИЗ
	|	РегистрСведений.ikon_cost_ДетализацияЗатратСебестоимости КАК Данные
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.КлючиАналитикиУчетаНоменклатуры КАК КлючиАналитики
	|		ПО Данные.АналитикаУчетаПродукции = КлючиАналитики.Ссылка
	|ГДЕ
	|	Данные.Период = &Период
	|	И (&ПоВсемОрганизациям
	|			ИЛИ Данные.Организация В (&Организации))
	|	И (&ПоВсейПродукции
	|			ИЛИ КлючиАналитики.Номенклатура В (&Продукция))
	|	И (&ПоВсемПартиям
	|			ИЛИ Данные.ПартияПродукции В (&ПартииПродукции))";

	ТаблицаФакт = Запрос.Выполнить().Выгрузить();

	// Таблица выпусков (агрегация по продукции)
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КлючиАналитики.Номенклатура КАК Продукция,
	|	КлючиАналитики.Характеристика КАК ХарактеристикаПродукции,
	|	КлючиАналитики.Назначение КАК НазначениеПродукции,
	|	Данные.ПартияПродукции КАК ПартияПродукции,
	|	КлючиАналитики.Номенклатура КАК Полуфабрикат,
	|	КлючиАналитики.Характеристика КАК ХарактеристикаПолуфабриката,
	|	СУММА(Данные.КоличествоЗатрата) КАК КоличествоВыпуск,
	|	Данные.Организация КАК Организация,
	|	ВЫБОР
	|		КОГДА &ДанныеПоСебестоимости = 3
	|			ТОГДА Данные.Организация.ВалютаРегламентированногоУчета
	|		ИНАЧЕ &ВалютаУправленческогоУчета
	|	КОНЕЦ КАК Валюта
	|ИЗ
	|	РегистрСведений.ikon_cost_ДетализацияЗатратСебестоимости КАК Данные
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.КлючиАналитикиУчетаНоменклатуры КАК КлючиАналитики
	|		ПО Данные.АналитикаУчетаПродукции = КлючиАналитики.Ссылка
	|ГДЕ
	|	Данные.Период = &Период
	|	И Данные.Уровень = 0
	|	И (&ПоВсемОрганизациям ИЛИ Данные.Организация В (&Организации))
	|	И (&ПоВсейПродукции ИЛИ КлючиАналитики.Номенклатура В (&Продукция))
	|	И (&ПоВсемПартиям ИЛИ Данные.ПартияПродукции В (&ПартииПродукции))
	|
	|СГРУППИРОВАТЬ ПО
	|	КлючиАналитики.Номенклатура,
	|	КлючиАналитики.Характеристика,
	|	КлючиАналитики.Назначение,
	|	Данные.ПартияПродукции,
	|	Данные.Организация,
	|	ВЫБОР
	|		КОГДА &ДанныеПоСебестоимости = 3
	|			ТОГДА Данные.Организация.ВалютаРегламентированногоУчета
	|		ИНАЧЕ &ВалютаУправленческогоУчета
	|	КОНЕЦ";

	ТаблицаВыпуски = Запрос.Выполнить().Выгрузить();

	Результат = Новый Структура;
	Результат.Вставить("Факт", ТаблицаФакт);
	Результат.Вставить("Выпуски", ТаблицаВыпуски);

	Возврат Результат;

КонецФункции

// Удаляет кэшированные данные за период (для принудительного пересчёта)
//
// Параметры:
//   ПериодРасчёта - Дата - первый день месяца
//
Процедура ОчиститьКэшЗаПериод(ПериодРасчёта) Экспорт

	НаборЗаписей = РегистрыСведений.ikon_cost_ДетализацияЗатратСебестоимости.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Период.Установить(ПериодРасчёта);
	НаборЗаписей.Записать(Ложь); // Пустой набор = удаление (явно указываем удаление)

КонецПроцедуры

// Проверяет наличие кэшированных данных по конкретной продукции за период
//
// Параметры:
//   ПериодРасчёта - Дата - первый день месяца
//   Версия - Строка - версия алгоритма
//   СписокПродукции - Массив - список номенклатуры (если Неопределено или пустой - проверка всего периода)
//
// Возвращаемое значение:
//   Булево - Истина если данные есть для ВСЕХ указанных видов продукции
//
Функция ЕстьДанныеВКэшеПоПродукции(ПериодРасчёта, Версия, СписокПродукции = Неопределено) Экспорт

	// Если список не указан или пуст - проверяем наличие любых данных
	Если НЕ ЗначениеЗаполнено(СписокПродукции) Тогда
		Возврат ЕстьДанныеВКэше(ПериодРасчёта, Версия);
	КонецЕсли;

	// Проверяем, что для каждого вида продукции из списка есть хотя бы одна запись
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Ключи.Номенклатура КАК Продукция
		|ИЗ
		|	РегистрСведений.ikon_cost_ДетализацияЗатратСебестоимости КАК Данные
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.КлючиАналитикиУчетаНоменклатуры КАК Ключи
		|		ПО Данные.АналитикаУчетаПродукции = Ключи.Ссылка
		|ГДЕ
		|	Данные.Период = &Период
		|	И Данные.ВерсияРасчёта = &Версия
		|	И Ключи.Номенклатура В (&СписокПродукции)";

	Запрос.УстановитьПараметр("Период", ПериодРасчёта);
	Запрос.УстановитьПараметр("Версия", Версия);
	Запрос.УстановитьПараметр("СписокПродукции", СписокПродукции);

	Результат = Запрос.Выполнить();
	НайденныеПродукции = Результат.ВыгрузитьКолонку("Продукция");

	// Проверяем, что все запрошенные продукции найдены
	Для Каждого Продукция Из СписокПродукции Цикл
		Если НайденныеПродукции.Найти(Продукция) = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;

КонецФункции

// Удаляет кэшированные данные по конкретной продукции за период
//
// Параметры:
//   ПериодРасчёта - Дата - первый день месяца
//   СписокАналитики - Массив - список КлючиАналитикиУчетаНоменклатуры
//                               (если Неопределено или пустой - удалить всё за период)
//
Процедура ОчиститьКэшПоПродукции(ПериодРасчёта, СписокАналитики = Неопределено) Экспорт

	// Если список не указан или пуст - удаляем все записи за период
	Если НЕ ЗначениеЗаполнено(СписокАналитики) Тогда
		ОчиститьКэшЗаПериод(ПериодРасчёта);
		Возврат;
	КонецЕсли;

	// Подход: получаем все записи за период ИСКЛЮЧАЯ указанную аналитику,
	// и записываем их обратно с замещением.
	// Это эффективно удаляет записи по указанной аналитике.

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Данные.Период КАК Период,
		|	Данные.АналитикаУчетаПродукции КАК АналитикаУчетаПродукции,
		|	Данные.ПартияПродукции КАК ПартияПродукции,
		|	Данные.АналитикаУчетаПартийПродукции КАК АналитикаУчетаПартийПродукции,
		|	Данные.Номенклатура КАК Номенклатура,
		|	Данные.Характеристика КАК Характеристика,
		|	Данные.Серия КАК Серия,
		|	Данные.ПартияЗатрата КАК ПартияЗатрата,
		|	Данные.АналитикаУчетаПартийЗатрата КАК АналитикаУчетаПартийЗатрата,
		|	Данные.ТипЗатрат КАК ТипЗатрат,
		|	Данные.Подразделение КАК Подразделение,
		|	Данные.Уровень КАК Уровень,
		|	Данные.ВерсияРасчёта КАК ВерсияРасчёта,
		|	Данные.ДатаРасчёта КАК ДатаРасчёта,
		|	Данные.Организация КАК Организация,
		|	Данные.КоличествоЗатрата КАК КоличествоЗатрата,
		|	Данные.СуммаЗатрата КАК СуммаЗатрата,
		|	Данные.СуммаЗабалансовая КАК СуммаЗабалансовая,
		|	Данные.Материальные КАК Материальные,
		|	Данные.Трудозатраты КАК Трудозатраты,
		|	Данные.ПостатейныеПостоянные КАК ПостатейныеПостоянные,
		|	Данные.ПостатейныеПеременные КАК ПостатейныеПеременные,
		|	Данные.ДопРасходы КАК ДопРасходы,
		|	Данные.НДД КАК НДД,
		|	Данные.МатериальныеСНДС КАК МатериальныеСНДС,
		|	Данные.ТрудозатратыСНДС КАК ТрудозатратыСНДС,
		|	Данные.ПостатейныеПостоянныеСНДС КАК ПостатейныеПостоянныеСНДС,
		|	Данные.ПостатейныеПеременныеСНДС КАК ПостатейныеПеременныеСНДС,
		|	Данные.ДопРасходыСНДС КАК ДопРасходыСНДС,
		|	Данные.МатериальныеБезНДС КАК МатериальныеБезНДС,
		|	Данные.ПостатейныеПостоянныеБезНДС КАК ПостатейныеПостоянныеБезНДС,
		|	Данные.ПостатейныеПеременныеБезНДС КАК ПостатейныеПеременныеБезНДС,
		|	Данные.ДопРасходыБезНДС КАК ДопРасходыБезНДС,
		|	Данные.МатериальныеУпр КАК МатериальныеУпр,
		|	Данные.ТрудозатратыУпр КАК ТрудозатратыУпр,
		|	Данные.ПостатейныеПостоянныеУпр КАК ПостатейныеПостоянныеУпр,
		|	Данные.ПостатейныеПеременныеУпр КАК ПостатейныеПеременныеУпр,
		|	Данные.ДопРасходыУпр КАК ДопРасходыУпр,
		|	Данные.СтоимостьЗабалансоваяУпр КАК СтоимостьЗабалансоваяУпр,
		|	Данные.МатериальныеРегл КАК МатериальныеРегл,
		|	Данные.ТрудозатратыРегл КАК ТрудозатратыРегл,
		|	Данные.ПостатейныеПостоянныеРегл КАК ПостатейныеПостоянныеРегл,
		|	Данные.ПостатейныеПеременныеРегл КАК ПостатейныеПеременныеРегл,
		|	Данные.ДопРасходыРегл КАК ДопРасходыРегл,
		|	Данные.СтоимостьЗабалансоваяРегл КАК СтоимостьЗабалансоваяРегл,
		|	Данные.НалоговыйУчет КАК НалоговыйУчет,
		|	Данные.ПостояннаяРазница КАК ПостояннаяРазница,
		|	Данные.ВременнаяРазница КАК ВременнаяРазница,
		|	Данные.ТребуетсяРазузлование КАК ТребуетсяРазузлование,
		|	Данные.ТребуетсяРазузлованиеДопРасходов КАК ТребуетсяРазузлованиеДопРасходов
		|ИЗ
		|	РегистрСведений.ikon_cost_ДетализацияЗатратСебестоимости КАК Данные
		|ГДЕ
		|	Данные.Период = &Период
		|	И НЕ Данные.АналитикаУчетаПродукции В (&СписокАналитики)";

	Запрос.УстановитьПараметр("Период", ПериодРасчёта);
	Запрос.УстановитьПараметр("СписокАналитики", СписокАналитики);

	Результат = Запрос.Выполнить();
	ТаблицаОставшихся = Результат.Выгрузить();

	// Создаём набор записей и загружаем оставшиеся записи
	НаборЗаписей = РегистрыСведений.ikon_cost_ДетализацияЗатратСебестоимости.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Период.Установить(ПериодРасчёта);
	НаборЗаписей.Загрузить(ТаблицаОставшихся);
	НаборЗаписей.Записать(Истина); // Замещение - удалит все записи за период и запишет только оставшиеся

КонецПроцедуры

// Получает список КлючиАналитикиУчетаНоменклатуры по списку номенклатуры за период
//
// Параметры:
//   ПериодРасчёта - Дата - период для поиска выпусков
//   ДатаОкончания - Дата - дата окончания периода
//   СписокНоменклатуры - Массив - список номенклатуры
//
// Возвращаемое значение:
//   Массив - список КлючиАналитикиУчетаНоменклатуры
//
Функция ПолучитьАналитикуПоНоменклатуре(ПериодРасчёта, ДатаОкончания, СписокНоменклатуры) Экспорт

	Если НЕ ЗначениеЗаполнено(СписокНоменклатуры) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ВыпускПродукции.АналитикаУчетаПродукции КАК Аналитика
		|ИЗ
		|	РегистрНакопления.ВыпускПродукции КАК ВыпускПродукции
		|ГДЕ
		|	ВыпускПродукции.Период МЕЖДУ &ПериодРасчёта И &ДатаОкончания
		|	И ВыпускПродукции.Номенклатура В (&СписокНоменклатуры)";

	Запрос.УстановитьПараметр("ПериодРасчёта", ПериодРасчёта);
	Запрос.УстановитьПараметр("ДатаОкончания", ДатаОкончания);
	Запрос.УстановитьПараметр("СписокНоменклатуры", СписокНоменклатуры);

	Результат = Запрос.Выполнить();
	Возврат Результат.ВыгрузитьКолонку("Аналитика");

КонецФункции

#КонецОбласти
