		| '06.06.2025' | 'ПТО: Вулканизация' | '_{!Формат(ТекущаяДатаСеанса(),"ДФ=yyyy-MM-dd")}_тест_А/шина' | '18,000'              | 'нет'   | '0,000'            | '10.3.5. Цех вулканизации' | '_{!Формат(ТекущаяДатаСеанса(),"ДФ=yyyy-MM-dd")}_тест_Протектор' | '11,000'     | '_{!Формат(ТекущаяДатаСеанса(),"ДФ=yyyy-MM-dd")}_тест_Отходы протектора' | '7,000'       |
