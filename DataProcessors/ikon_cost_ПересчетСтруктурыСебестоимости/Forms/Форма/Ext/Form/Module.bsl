////////////////////////////////////////////////////////////////////////////////
// МОДУЛЬ ФОРМЫ: Пересчет структуры себестоимости
// НАЗНАЧЕНИЕ: Запуск многопоточного расчёта кэша себестоимости продукции
//
// Форма позволяет пересчитать кэш себестоимости за указанный период
// с использованием нескольких фоновых заданий для ускорения обработки.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Разбивает массив на порции указанного размера.
//
// Параметры:
//  Массив - Массив - исходный массив для разбиения
//  РазмерПачки - Число - размер одной порции
//
// Возвращаемое значение:
//  Массив - массив массивов, каждый из которых содержит не более РазмерПачки элементов
//
&НаКлиентеНаСервереБезКонтекста
Функция РазбитьМассивПоПачкам(Массив, РазмерПачки)

	Результат = Новый Массив();

	Если Массив.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Результат.Добавить(Новый Массив());

	Для Каждого Элемент Из Массив Цикл
		Если Результат[Результат.Количество() - 1].Количество() = РазмерПачки Тогда
			Результат.Добавить(Новый Массив());
		КонецЕсли;
		Результат[Результат.Количество() - 1].Добавить(Элемент);
	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область ОбработчикиСобытийФормы

// Обработчик события создания формы на сервере.
// Инициализирует параметры формы значениями по умолчанию.
//
// Параметры:
//  Отказ - Булево - признак отказа от создания формы
//  СтандартнаяОбработка - Булево - признак стандартной обработки
//
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	// Количество фоновых потоков по умолчанию
	Объект.КоличествоПотоков = 8;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

// Обработчик команды запуска расчёта.
// Запускает многопоточный расчёт кэша себестоимости и настраивает ожидание завершения.
//
// Параметры:
//  Команда - КомандаФормы - команда формы
//
&НаКлиенте
Процедура ЗапуститьРасчет(Команда)

	// Запускаем длительную операцию на сервере
	ДлительнаяОперация = НачатьРасчетНаСервере();

	// Проверяем, что операция запущена
	Если ДлительнаяОперация = Неопределено Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(
			НСтр("ru = 'Не удалось запустить операцию расчёта.'"));
		Возврат;
	КонецЕсли;

	// Настраиваем оповещение о завершении
	ОписаниеОповещения = Новый ОписаниеОповещения("ЗавершениеРасчетаНаКлиенте", ЭтотОбъект);

	// Настраиваем параметры ожидания
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ВыводитьПрогрессВыполнения = Истина;
	ПараметрыОжидания.ОтменятьПриЗакрытииФормыВладельца = Ложь;

	// Настройка оповещения пользователя
	ОповещениеПользователя = ПараметрыОжидания.ОповещениеПользователя;
	ОповещениеПользователя.Показать = Истина;
	ОповещениеПользователя.Текст = НСтр("ru = 'Выполняется расчет детализации себестоимости'");

	// КРИТИЧНО: Запускаем ожидание завершения операции!
	ДлительныеОперацииКлиент.ОжидатьЗавершение(ДлительнаяОперация, ОписаниеОповещения, ПараметрыОжидания);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеМетодыСервер

// Запускает многопоточный расчёт кэша себестоимости.
//
// Возвращаемое значение:
//  Структура - дескриптор длительной операции:
//    * АдресРезультата - Строка - адрес временного хранилища результатов
//    * ИдентификаторЗадания - УникальныйИдентификатор - идентификатор фонового задания
//
&НаСервере
Функция НачатьРасчетНаСервере()

	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияФункции(УникальныйИдентификатор);

	НаборПараметров = Новый Соответствие;

	// Получаем список продукции за выбранный период
	ВсяПродукция = ikon_cost_СтруктураСебестоимостиФоновый.ПолучитьСписокНоменклатурыЗаПериод(
		Объект.Период.ДатаНачала,
		Объект.Период.ДатаОкончания,
		Объект.Пересчитать);

	// Рассчитываем размер порции для каждого потока
	РазмерПачки = Цел(ВсяПродукция.Количество() / Объект.КоличествоПотоков)
		+ ?(ВсяПродукция.Количество() % Объект.КоличествоПотоков = 0, 0, 1);

	// Разбиваем продукцию на порции для параллельной обработки
	Порции = РазбитьМассивПоПачкам(ВсяПродукция, РазмерПачки);
	
	// Формируем параметры для каждого потока
	Для НомерПотока = 1 По Порции.Количество() Цикл

		ПараметрыФункцииДляПотока = Новый Массив;

		ПараметрыВыполненияПорции = Новый Структура;
		ПараметрыВыполненияПорции.Вставить("НачалоПериода",            Объект.Период.ДатаНачала);
		ПараметрыВыполненияПорции.Вставить("КонецПериода",             Объект.Период.ДатаОкончания);
		ПараметрыВыполненияПорции.Вставить("ПринудительноПересчитать", Объект.Пересчитать);
		ПараметрыВыполненияПорции.Вставить("ОтборПоПродукции",         Порции[НомерПотока - 1]);
 		ПараметрыВыполненияПорции.Вставить("Потоков",                  Порции.Количество());
		ПараметрыВыполненияПорции.Вставить("Итераций",                 ВсяПродукция.Количество());
		ПараметрыВыполненияПорции.Вставить("КодПотока",                НомерПотока);

		ПараметрыФункцииДляПотока.Добавить(ПараметрыВыполненияПорции);
		НаборПараметров.Вставить(НомерПотока, ПараметрыФункцииДляПотока);

	КонецЦикла;

	// Запускаем выполнение функции в нескольких потоках
	ДлительнаяОперация = ДлительныеОперации.ВыполнитьФункциюВНесколькоПотоков(
		"ikon_cost_СтруктураСебестоимостиФоновый.ПредварительныйРасчётКэшаСебестоимости",
		ПараметрыВыполнения,
		НаборПараметров);

	Возврат ДлительнаяОперация;

КонецФункции

// Обрабатывает результаты выполнения потоков расчёта.
//
// Параметры:
//  АдресВременногоХранилища - Строка - адрес хранилища с результатами всех потоков
//
&НаСервере
Процедура ЗавершениеРасчетаНаСервере(АдресВременногоХранилища)

	Объект.Прогресс.Очистить();

	// Получаем результаты всех потоков
	РезультатыПотоков = ПолучитьИзВременногоХранилища(АдресВременногоХранилища);

	Если РезультатыПотоков = Неопределено Тогда
		ОбщегоНазначения.СообщитьПользователю(
			НСтр("ru = 'Не удалось получить результаты выполнения.'"));
		Возврат;
	КонецЕсли;

	КоличествоУспешных = 0;
	КоличествоОшибок = 0;

	Для Каждого КлючЗначение Из РезультатыПотоков Цикл

		НомерПотока = КлючЗначение.Ключ;
		РезультатПотока = КлючЗначение.Значение;

		// Проверяем статус потока
		Если РезультатПотока.Статус = "Ошибка" Тогда

			КоличествоОшибок = КоличествоОшибок + 1;
			ОбщегоНазначения.СообщитьПользователю(
				СтрШаблон(НСтр("ru = 'Поток %1: %2'"),
					НомерПотока,
					ОбработкаОшибок.КраткоеПредставлениеОшибки(РезультатПотока.ИнформацияОбОшибке)));
			Продолжить;

		КонецЕсли;

		// Получаем результат потока
		Если ЗначениеЗаполнено(РезультатПотока.АдресРезультата) Тогда

			ТаблицаРезультата = ПолучитьИзВременногоХранилища(РезультатПотока.АдресРезультата);

			Если ТаблицаРезультата <> Неопределено Тогда
				ОбщегоНазначенияКлиентСервер.ДополнитьТаблицу(ТаблицаРезультата, Объект.Прогресс);
				КоличествоУспешных = КоличествоУспешных + 1;
			КонецЕсли;

		КонецЕсли;

	КонецЦикла;

	// Выводим итоги
	ОбщегоНазначения.СообщитьПользователю(
		СтрШаблон(НСтр("ru = 'Расчёт завершён. Успешно: %1, ошибок: %2'"),
			КоличествоУспешных,
			КоличествоОшибок));

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиОповещений

// Callback-обработчик завершения длительной операции.
//
// Параметры:
//  РезультатВыполнения - Структура, Неопределено - результат длительной операции:
//    * Статус - Строка - "Выполнено", "Ошибка", "Отменено"
//    * АдресРезультата - Строка - адрес временного хранилища с результатами
//    * ИнформацияОбОшибке - ИнформацияОбОшибке - информация об ошибке (при наличии)
//  ДополнительныеПараметры - Структура - дополнительные параметры оповещения
//
&НаКлиенте
Процедура ЗавершениеРасчетаНаКлиенте(РезультатВыполнения, ДополнительныеПараметры) Экспорт

	// Проверяем, что операция вообще выполнялась
	Если РезультатВыполнения = Неопределено Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(
			НСтр("ru = 'Не удалось получить результат выполнения операции.'"));
		Возврат;
	КонецЕсли;

	// Проверяем статус выполнения
	Если РезультатВыполнения.Статус = "Ошибка" Тогда
		СтандартныеПодсистемыКлиент.ВывестиИнформациюОбОшибке(РезультатВыполнения.ИнформацияОбОшибке);
		Возврат;
	КонецЕсли;

	// Проверяем, что есть адрес результата
	Если НЕ ЗначениеЗаполнено(РезультатВыполнения.АдресРезультата) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(
			НСтр("ru = 'Результат выполнения не найден.'"));
		Возврат;
	КонецЕсли;

	// Обрабатываем результаты на сервере
	ЗавершениеРасчетаНаСервере(РезультатВыполнения.АдресРезультата);

КонецПроцедуры

#КонецОбласти
